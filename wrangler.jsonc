{
  "name": "brentkirklandcom",
  "account_id": "4736be44aaded3076775940a3d87da40",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-29",
  "assets": {
    "directory": "public",
    // robots.txt and sitemap.xml are also served as static files from
    // public/, but routing these two paths through the Worker first makes
    // sure our explicit routes win over any zone-level robots.txt
    // injection (e.g. Cloudflare's AI content-signals feature) and keeps
    // the sitemap generated from one source of truth in src/index.ts.
    "run_worker_first": ["/robots.txt", "/sitemap.xml"]
  },
  "minify": true,
  "routes": [
    { "pattern": "brentkirkland.com", "custom_domain": true },
    { "pattern": "www.brentkirkland.com", "custom_domain": true }
  ],
  // HI_WEBHOOK_URL and HI_WEBHOOK_TOKEN are wrangler secrets (not in git): wrangler secret put HI_WEBHOOK_URL / HI_WEBHOOK_TOKEN
  // AGENT_CHECKPOINT_WEBHOOK_URL and AGENT_CHECKPOINT_WEBHOOK_SECRET are optional wrangler secrets
  // for a Grok Bot ping on successful POST /agent (Authorization: Bearer <sender key>).
  // wrangler secret put AGENT_CHECKPOINT_WEBHOOK_URL / AGENT_CHECKPOINT_WEBHOOK_SECRET
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brentkirklandcom",
      "database_id": "bc6ba2ce-f8b2-40d4-abde-92f3880946db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "HI",
      "bucket_name": "brentkirklandcom-hi"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["hi@agents.brentkirkland.com"]
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "production"
  },
  "env": {
    "preview": {
      // Preview deployments use the same configuration as production
      // but can be customized here if needed
      // Empty routes prevent preview deploys from inheriting (and stealing) the
      // production custom domains defined at the top level.
      "routes": [],
      "triggers": {
        "crons": []
      },
      "vars": {
        "ENVIRONMENT": "preview"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "brentkirklandcom",
          "database_id": "bc6ba2ce-f8b2-40d4-abde-92f3880946db",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "HI",
          "bucket_name": "brentkirklandcom-hi"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_sender_addresses": ["hi@agents.brentkirkland.com"]
        }
      ]
    }
  }
}
